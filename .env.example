# Postgres connection string. `vercel env pull .env.local` sets this
# automatically once the Postgres (Neon) integration is installed on the
# Vercel project — see docs/architecture.md's "Local setup" section.
DATABASE_URL=

# Auth.js — sign-in session/token encryption. Generate with `npx auth secret`.
AUTH_SECRET=

# Resend — sends the email magic-link sign-in message. Also set
# automatically by `vercel env pull` once the Resend Marketplace
# integration is installed. Optional: EMAIL_FROM overrides the sender
# address (defaults to Resend's sandbox address, which works without a
# verified domain but is only deliverable to your own Resend account).
RESEND_API_KEY=
EMAIL_FROM=

# MCP server (src/mcp/) dev-only convenience — see docs/mcp.md's
# "Authentication" section. Never has any effect in production
# (NODE_ENV=production disables the fallback these enable).
SIMMER_MCP_DEV_USER_ID=

# Enables api/chat.ts to run the OpenAI Agents SDK for the "Nomi" chatbot
# experiment (src/app/experiments/chatbot). Without it, that endpoint
# returns mocked replies instead of calling a real model — see api/chat.ts.
OPENAI_API_KEY=
