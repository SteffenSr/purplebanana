# Postgres. Installing the Postgres (Neon) integration from the Vercel
# Marketplace and running `vercel env pull .env.local` sets these
# automatically — see docs/architecture.md's "Local setup" section.
# DATABASE_URL is the pooled connection the app uses at runtime;
# DATABASE_URL_UNPOOLED (or the Vercel-legacy-named POSTGRES_URL /
# POSTGRES_URL_NON_POOLING) is what migrations use — see drizzle.config.ts.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Auth.js — sign-in session/token encryption. Generate with `npx auth secret`.
AUTH_SECRET=

# Resend — sends the email magic-link sign-in message. Also set
# automatically by `vercel env pull` once the Resend Marketplace
# integration is installed; the exact names depend on what you named the
# connection when installing it (these match a connection named
# "magic_link" — rename in src/auth.ts if yours differs).
# MAGIC_LINK_RESEND_EMAIL_DOMAIN is a verified sending domain, not a full
# address — src/auth.ts builds "Simmer <login@<domain>>" from it, falling
# back to Resend's onboarding@resend.dev sandbox sender if unset.
MAGIC_LINK_RESEND_API_KEY=
MAGIC_LINK_RESEND_EMAIL_DOMAIN=

# MCP server (src/mcp/) dev-only convenience — see docs/mcp.md's
# "Authentication" section. Never has any effect in production
# (NODE_ENV=production disables the fallback these enable).
SIMMER_MCP_DEV_USER_ID=

# Enables api/chat.ts to run the OpenAI Agents SDK for the "Nomi" chatbot
# experiment (src/app/experiments/chatbot). Without it, that endpoint
# returns mocked replies instead of calling a real model — see api/chat.ts.
OPENAI_API_KEY=
